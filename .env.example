# Bellvero Group website — environment variables. Copy to .env.local for development.

# Canonical site URL (no trailing slash). Client to confirm bellvero.com vs bellverogroup.com.
NEXT_PUBLIC_SITE_URL=https://bellvero.com

# CMS (Payload, admin at /admin). Server-side only: never prefix these with NEXT_PUBLIC_.
# Neon Postgres connection string. On Vercel, the Neon integration sets DATABASE_URL (pooled)
# automatically; use a separate Neon branch for Preview so previews never touch production.
DATABASE_URL=
# Long random string used to sign admin sessions, e.g. `openssl rand -hex 32`. A different
# value per environment; changing it signs every admin out.
PAYLOAD_SECRET=

# Enquiry register (spec §20.5). Required in production: without it the form shows its
# error state instead of losing enquiries. Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instant notifications (spec §20.2): Telegram bot to at least two chats, plus email copy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=            # comma-separated, e.g. 12345,67890
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=           # e.g. Bellvero Website <enquiries@your-domain>
ENQUIRY_EMAIL_TO=             # comma-separated, at least two recipients
ALERT_WEBHOOK_URL=            # optional: receives a POST when delivery fails

# GA4 (spec §24). Loads only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# Staging only: shows the "Preview — test enquiries" bar and disables analytics.
NEXT_PUBLIC_STAGING=
